# Anthropic API anahtarı — https://console.anthropic.com
VITE_ANTHROPIC_KEY=your-anthropic-api-key-here

# TMDB (The Movie Database) API anahtarı — https://www.themoviedb.org/settings/api
# Ücretsiz kayıt → Settings → API → Request an API Key (Developer)
VITE_TMDB_KEY=your-tmdb-api-key-here

# ── Giriş + cihazlar arası favoriler (Supabase) ───────────────────────────────
# Boş bırakılırsa giriş kapalı kalır ve favoriler yalnızca localStorage'da tutulur.
# Kurulum adımları için: supabase/SETUP.md
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
